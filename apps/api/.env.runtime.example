# Synthetic local container rehearsal only. Copy to .env.runtime.local, preserving existing files.
# Replace all credentials and review deployment policy before any external use.
API_APP_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
API_HOST_PORT=3001
DATABASE_URL=postgresql://synthetic_api:synthetic_local_password@postgres:5432/ride_match_runtime
API_ALLOWED_ORIGINS=
API_LOG_LEVEL=warn
API_AUTH_SECRET=synthetic-runtime-hmac-key-change-before-any-external-use
API_SMS_PROVIDER=disabled
API_PUSH_PROVIDER=disabled
POSTGRES_USER=synthetic_api
POSTGRES_PASSWORD=synthetic_local_password
POSTGRES_DB=ride_match_runtime
