# Synthetic local-only values; copy to .env.local. Never use these externally.
API_APP_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://ride_match_local:synthetic_local_only@127.0.0.1:55432/ride_match_local
API_ALLOWED_ORIGINS=http://localhost:3001
API_LOG_LEVEL=info

# Docker Compose only; keep in sync with DATABASE_URL above.
POSTGRES_USER=ride_match_local
POSTGRES_PASSWORD=synthetic_local_only
POSTGRES_DB=ride_match_local
POSTGRES_PORT=55432

# Synthetic local-only auth configuration; production rejects the development provider.
API_AUTH_SECRET=synthetic-be002-local-key-change-before-external-use
API_SMS_PROVIDER=development

# External push is explicitly disabled until an Expo project and credentials are configured.
API_PUSH_PROVIDER=disabled
# EXPO_PUSH_ACCESS_TOKEN is server-only and required only with API_PUSH_PROVIDER=expo.

# Optional listen address. Keep loopback on the host; container runtime sets 0.0.0.0 internally.
API_HOST=127.0.0.1
