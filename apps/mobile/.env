# Public build configuration, read by src/config/appConfig.ts. Expo inlines EXPO_PUBLIC_
# variables into the JavaScript bundle, so they are not secrets: never put credentials here.
# Override locally in .env.local (ignored by Git); restart Metro after any change.

# development, preview or production.
EXPO_PUBLIC_APP_ENV=development
# mock, or api (not available in the mobile MVP: the app shows a configuration error).
EXPO_PUBLIC_DATA_SOURCE=mock
# Initial mock scenario key; see docs/MOCK_SCENARIOS.md.
EXPO_PUBLIC_MOCK_SCENARIO=active-neighborhood
