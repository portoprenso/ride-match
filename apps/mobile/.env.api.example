# Optional local backend configuration (through BE-005); default committed .env remains mock.
# Merge these values into .env.local without overwriting other local settings.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/v1
# The local API development OTP provider accepts +447700900000..999 only.
# Synthetic code: 123456. No SMS is sent. No credentials belong in public env.
# API supports all 25 REST operations and Socket.IO. External push remains disabled.
# EAS_PROJECT_ID may name an existing project for real tokens; no project is configured here.
