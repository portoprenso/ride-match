{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ride-match/mobile#dev": {
      "dependsOn": ["^build"],
      "with": ["@ride-match/contracts#dev"],
      "passThroughEnv": [
        "EXPO_*",
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "REACT_NATIVE_PACKAGER_HOSTNAME",
        "RCT_METRO_PORT",
        "EDITOR",
        "VISUAL",
        "HTTP_PROXY",
        "TMPDIR"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
