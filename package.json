{
  "name": "ride-match",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "^24.17.0"
  },
  "scripts": {
    "build:contracts": "turbo run build --filter=@ride-match/contracts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contracts": "pnpm --filter @ride-match/contracts test",
    "test:mobile": "pnpm build:contracts && pnpm --filter @ride-match/mobile test",
    "dev": "turbo run dev --filter=@ride-match/mobile",
    "dev:mobile": "pnpm build:contracts && pnpm --filter @ride-match/mobile start",
    "doctor:mobile": "pnpm --filter @ride-match/mobile run doctor",
    "export:android": "pnpm build:contracts && pnpm --filter @ride-match/mobile export:android",
    "export:ios": "pnpm build:contracts && pnpm --filter @ride-match/mobile export:ios",
    "mobile:android": "pnpm build:contracts && pnpm --filter @ride-match/mobile android",
    "mobile:ios": "pnpm build:contracts && pnpm --filter @ride-match/mobile ios",
    "build:api": "turbo run build --filter=@ride-match/api",
    "dev:api": "pnpm build:api && turbo run dev --filter=@ride-match/api",
    "start:api": "pnpm --filter @ride-match/api start",
    "db:up": "pnpm --filter @ride-match/api db:up",
    "db:down": "pnpm --filter @ride-match/api db:down",
    "db:migrate": "pnpm build:api && pnpm --filter @ride-match/api migrate",
    "test:api": "pnpm build:api && pnpm --filter @ride-match/api test",
    "test:api:integration": "pnpm build:api && pnpm --filter @ride-match/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "turbo": "2.11.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
